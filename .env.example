# Telegram order notifications
#
# 1. Create a bot with @BotFather on Telegram -> copy the token here.
# 2. Get your chat id: message your bot, then open in a browser:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates  -> "chat":{"id":<number>}
# 3. Copy this file to ".env" (local dev) and set the SAME values as
#    Environment Variables in Vercel (Settings -> Environment Variables).
VITE_TELEGRAM_BOT_TOKEN=123456:ABC-paste_your_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_number

# OPTIONAL - real Gmail delivery for the contact / feedback forms (Vercel only):
# 1. Enable Google 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: Google Account > Security > "App passwords"
#    (name it e.g. "genz-wear"). Use that 16-character password below.
# 3. Add GMAIL_USER, GMAIL_APP_PASSWORD (and optionally GMAIL_TO) as
#    Environment Variables in Vercel > Settings > Environment Variables,
#    then Redeploy. Without these, feedback still reaches you via the
#    Telegram bot instead.
GMAIL_USER=your.gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_TO=phenmakara247@gmail.com